# General Configuration
ENVIRONMENT=development

# Neo4j connection
NEO4J_URI=your_neo4j_uri
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=your_aura_instance_id
AURA_INSTANCENAME=your_aura_instance_name

# LLM API keys
OPENAI_API_KEY=
GOOGLE_API_KEY=your_google_api_key
GEMINI_API_KEY=your_google_api_key  # Optional: Fallback for GOOGLE_API_KEY
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# Frontend Configuration
VITE_BACKEND_URL=http://localhost:8000

# Tracing and Telemetry
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces

# Note: there is no env var to select the Gemini model. LLMExtractionService's
# DEFAULT_MODEL (gemini-2.5-flash) and llm_manager.py's per-provider model
# names (gemini-2.5-pro, gemini-2.5-flash, gpt-4o, claude-sonnet-5,
# mistral-large-latest) are hardcoded and selected per-request via API params,
# not env-configurable. (GEMINI_MODEL_DEFAULT/GEMINI_PRO_MODEL used to be
# listed here but were never actually read anywhere in the codebase - removed
# rather than left as dead, misleading config.)

# Redis Cache
# NOT optional - enabled by default (docker-compose.yml's CACHE_ENABLED
# defaults to true) and backs LLM/GraphRAG-result caching, the Celery task
# broker, rate limiting, and shared usage/cost/hallucination counters shared
# across the backend and worker containers.
REDIS_URL=redis://localhost:6379
TASK_OWNERSHIP_TTL_SECONDS=86400
MCP_STANDALONE_LOCAL_ONLY=false
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=3600

# Cache TTL by operation (seconds)
CACHE_TTL_DEVIATION=1800
CACHE_TTL_JURISDICTION=3600
CACHE_TTL_PRECEDENT=7200
CACHE_TTL_CLAUSE_EXTRACTION=86400
CACHE_TTL_POLICY_EVALUATION=86400
CACHE_TTL_VECTOR_SEARCH=600

# Performance Monitoring
MONITORING_ENABLED=true
ALERT_THRESHOLD_CUAD=5000
ALERT_THRESHOLD_DEVIATION=2000
ALERT_THRESHOLD_PRECEDENT=3000
ALERT_THRESHOLD_JURISDICTION=1000

# Parallel Processing
MAX_WORKERS_DEVIATION=3
MAX_WORKERS_PRECEDENT=5
MAX_WORKERS_BATCH=5

# Timeouts (seconds)
TIMEOUT_PATTERN_MATCHING=1.0
TIMEOUT_PRECEDENT_CLAUSE=5.0
TIMEOUT_BATCH_CONTRACT=30.0

# Batch Processing
MAX_BATCH_SIZE=50
BACKGROUND_BATCH_THRESHOLD=10
BATCH_SEMAPHORE_LIMIT=5

# Feature Flags
ENABLE_SEMANTIC_ANALYSIS=true
ENABLE_PARALLEL_PROCESSING=true
ENABLE_ADAPTIVE_LEARNING=true
ENABLE_PHASE_FALLBACK=true

# Authentication & Encryption
# Both fall back to a loudly-logged, insecure dev-only default if unset -
# fine for local dev, but validate_production_secret()/validate_production_key()
# hard-fail application startup if either is unset (or still the dev default)
# when ENVIRONMENT=production.
JWT_SECRET_KEY=
ENCRYPTION_KEY=
# Comma-separated allowed origins, required in production (permissive by
# default in dev). Fails closed (no cross-origin access at all) rather than
# falling back to "*" if unset in production.
CORS_ALLOWED_ORIGINS=
# "env" (default) reads ENCRYPTION_KEY above directly. "gcp" fetches the key
# from GCP Secret Manager instead - requires GCP_PROJECT_ID/GCP_SECRET_ID and
# real IAM permissions; only meaningful for the real GCP deployment
# (docs/DEPLOYMENT.md), not local dev.
KEY_PROVIDER=env
GCP_PROJECT_ID=
GCP_SECRET_ID=ENCRYPTION_KEY

# Credential Provisioning: Google OIDC SSO, org invites, transactional email
# Only needed to exercise SSO/invite-email flows locally - MFA (TOTP) needs
# no external configuration at all. See docs/CAPSTONE_SUMMARY.md §16 and
# docs/DEPLOYMENT.md for the full real-account setup (a real Google OAuth
# client, a real Resend account).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/oidc/callback
RESEND_API_KEY=
INVITE_EMAIL_FROM=onboarding@resend.dev
# Where the OIDC callback's session-bridge page and invite-acceptance emails
# redirect/link back into - the frontend's own origin, not the backend's.
FRONTEND_BASE_URL=http://localhost:3000

# Auth rate limiting (optional overrides - shown defaults match the code's
# own fallback, so these lines are informational unless you want different
# limits)
AUTH_TOKEN_RATE_LIMIT=10/minute
AUTH_REGISTER_RATE_LIMIT=5/minute
AUTH_MFA_VERIFY_RATE_LIMIT=10/minute
AUTH_INVITE_ACCEPT_RATE_LIMIT=10/minute
