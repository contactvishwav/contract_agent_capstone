#Neo4j connection - defaults to the local docker-compose Neo4j service
# (see docker-compose.yml). To use the shared public demo instance instead,
# set NEO4J_URI=neo4j+s://demo.neo4jlabs.com:7687 with its own credentials -
# not recommended for anything that writes data (contract uploads, policy
# uploads, migrations), since it's shared with other users/projects.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=legalcontracts_local_dev
NEO4J_DATABASE=neo4j

GOOGLE_API_KEY=

# Field-level encryption at rest for stored contract text (Contract.full_text,
# Clause.content). Without this set, an insecure hardcoded dev-only key is
# used (loudly logged) - fine for local dev, never for real contract data.
# Generate a real value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=

# JWT signing secret (backend/governance/auth.py) - tokens issued by
# POST /api/auth/token carry tenant_id + role as claims, validated on
# every subsequent request. Without this set, an insecure hardcoded
# dev-only secret is used (loudly logged) - fine for local dev, never for
# real use, since anyone who knows the default could forge a valid token.
# Generate a real value the same way as ENCRYPTION_KEY above.
JWT_SECRET_KEY=

# Google OIDC ("Sign in with Google") - Google Cloud Console > APIs &
# Services > Credentials > OAuth client ID > Web application. Distinct from
# GOOGLE_API_KEY above (that's a Gemini API key, unrelated credential type).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/oidc/callback

# Resend (transactional email for org invites) - resend.com API key.
RESEND_API_KEY=
# Sandbox sender (works without a verified domain, but only delivers to the
# Resend account's own verified email) - replace once a domain is verified.
INVITE_EMAIL_FROM=onboarding@resend.dev
FRONTEND_BASE_URL=http://localhost:5173

# Phase 3 Configuration
# Redis Cache - defaults to the local docker-compose Redis service
REDIS_URL=redis://localhost:6379
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=3600

# Cache TTL by operation (seconds)
CACHE_TTL_DEVIATION=1800
CACHE_TTL_JURISDICTION=3600
CACHE_TTL_PRECEDENT=7200

# Performance Monitoring
MONITORING_ENABLED=true
ALERT_THRESHOLD_CUAD=5000
ALERT_THRESHOLD_DEVIATION=2000
ALERT_THRESHOLD_PRECEDENT=3000
ALERT_THRESHOLD_JURISDICTION=1000

# Parallel Processing
MAX_WORKERS_DEVIATION=3
MAX_WORKERS_PRECEDENT=5
MAX_WORKERS_BATCH=5

# Timeouts (seconds)
TIMEOUT_PATTERN_MATCHING=1.0
TIMEOUT_PRECEDENT_CLAUSE=5.0
TIMEOUT_BATCH_CONTRACT=30.0

# Batch Processing
MAX_BATCH_SIZE=50
BACKGROUND_BATCH_THRESHOLD=10
BATCH_SEMAPHORE_LIMIT=5

# Feature Flags
ENABLE_SEMANTIC_ANALYSIS=true
ENABLE_PARALLEL_PROCESSING=true
ENABLE_ADAPTIVE_LEARNING=true
ENABLE_PHASE_FALLBACK=true
